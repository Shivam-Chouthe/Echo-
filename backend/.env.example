# Copy to .env (gitignored) or export these in your shell before running uvicorn.

# Required — Google AI Studio Gemini API key.
GEMINI_API_KEY=your_gemini_key_here

# Optional — override the model (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional — if set, callers must send a matching "X-API-Key" header.
# Leave unset for local dev; SET THIS before exposing the server on a network.
# ECHO_BACKEND_API_KEY=some-long-random-shared-secret
